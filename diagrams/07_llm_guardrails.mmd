    O2["Revised exemplars\nwith contradictions\nresolved"]:::output
    O4["Guard-rail-approved\nfirst-pass SHACL\n(no logical operators)"]:::output
    O7["Verified test suite\ninstances for\nTest Phase 6"]:::output

