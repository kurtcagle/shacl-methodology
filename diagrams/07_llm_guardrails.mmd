    P2["Phase 2\nExemplar Review"]:::phase
    P4["Phase 4\nSchema Generation"]:::phase
    P7["Phase 7\nTest Data Generation"]:::phase

    LLM2["🤖 LLM\nObservation pass"]:::llm
    LLM4["🤖 LLM\nSHACL first-pass"]:::llm
